MoveTab:CreateToggle({
    Name = "飞行",
    CurrentValue = false,
    Flag = "FlyToggle",
    Callback = function(state)
        FlyEnabled = state
        getgenv().FlyEnabled = state
        getgenv().FlySpeed = FlySpeed

        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChild("Humanoid")
        if not hrp or not hum then return end

        if state then
            getgenv().FlyLoop = true

            local anim = char:FindFirstChild("Animate")
            if anim then anim.Parent = nil end

            local bv = Instance.new("BodyVelocity")
            bv.MaxForce = Vector3.new(1e6, 1e6, 1e6)
            bv.Parent = hrp

            local bg = Instance.new("BodyGyro")
            bg.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
            bg.P = 8000
            bg.Parent = hrp

            getgenv().FlyBV = bv
            getgenv().FlyBG = bg
            getgenv().FlyAnim = anim

            task.spawn(function()
                while getgenv().FlyEnabled and getgenv().FlyLoop and char.Parent do
                    local speed = getgenv().FlySpeed or 100
                    local mv = ctrl and ctrl:GetMoveVector() or Vector3.zero
                    local cam = workspace.CurrentCamera

                    local dir = (cam.CFrame.LookVector * -mv.Z) + (cam.CFrame.RightVector * mv.X)
                    if mv.Magnitude > 0 then
                        bv.Velocity = dir.Unit * speed
                        bg.CFrame = CFrame.new(Vector3.zero, Vector3.new(dir.X, 0, dir.Z))
                    else
                        bv.Velocity = Vector3.new(0, 0.1, 0)
                        bg.CFrame = CFrame.new(Vector3.zero, Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z))
                    end

                    hum:ChangeState(Enum.HumanoidStateType.Physics)
                    RunService.RenderStepped:Wait()
                end

                if getgenv().FlyBV then getgenv().FlyBV:Destroy() getgenv().FlyBV = nil end
                if getgenv().FlyBG then getgenv().FlyBG:Destroy() getgenv().FlyBG = nil end
                if getgenv().FlyAnim then getgenv().FlyAnim.Parent = char getgenv().FlyAnim = nil end
            end)

            Rayfield:Notify({
                Title = "飞行开启",
                Content = "🤔",
                Duration = 2,
            })
        else
            getgenv().FlyLoop = false
            task.wait(0.1)

            if getgenv().FlyBV then
                getgenv().FlyBV:Destroy()
                getgenv().FlyBV = nil
            end
            if getgenv().FlyBG then
                getgenv().FlyBG:Destroy()
                getgenv().FlyBG = nil
            end

            if getgenv().FlyAnim and char then
                getgenv().FlyAnim.Parent = char
                getgenv().FlyAnim = nil
            end

            if hum then
                hum:ChangeState(Enum.HumanoidStateType.Running)
                hum.PlatformStand = false
                hum.Sit = false
            end

            if hrp then
                hrp.Velocity = Vector3.zero
                hrp.RotVelocity = Vector3.zero
            end

            Rayfield:Notify({
                Title = "飞行关闭",
                Content = "已恢复",
                Duration = 2,
            })
        end
    end,
})
