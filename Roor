local function IsTeamMatchESP(p)
    if ESPIgnoreTeam and p.Team and player.Team and p.Team == player.Team then
        return false
    end
    if ESPTeam == "全部" then return true end
    if not p.Team then return false end
    local t = p.Team.Name:lower()
    if ESPTeam == "囚犯" then
        return t:find("criminal") or t:find("囚犯")
    elseif ESPTeam == "警察" then
        return t:find("guard") or t:find("police") or t:find("警察")
    elseif ESPTeam == "逃出者" then
        return t:find("escape") or t:find("逃")
    end
    return false
end

local SKELETON_BONES = {
    {"Head", "Torso"},
    {"Torso", "Left Arm"},
    {"Torso", "Right Arm"},
    {"Torso", "Left Leg"},
    {"Torso", "Right Leg"},
}

local ESPObjects = {}

local function CreateESPForPlayer(p)
    if ESPObjects[p] then return end
    ESPObjects[p] = {
        Box = Drawing.new("Square"),
        Name = Drawing.new("Text"),
        Dist = Drawing.new("Text"),
        Health = Drawing.new("Line"),
        Highlight = Instance.new("Highlight"),
        SkeletonLines = {},
    }
    ESPObjects[p].Box.Thickness = 1
    ESPObjects[p].Box.Filled = false
    ESPObjects[p].Box.Transparency = 1
    ESPObjects[p].Box.Visible = false

    ESPObjects[p].Name.Size = 14
    ESPObjects[p].Name.Center = true
    ESPObjects[p].Name.Outline = true
    ESPObjects[p].Name.Visible = false

    ESPObjects[p].Dist.Size = 12
    ESPObjects[p].Dist.Center = true
    ESPObjects[p].Dist.Outline = true
    ESPObjects[p].Dist.Color = Color3.fromRGB(200, 200, 255)
    ESPObjects[p].Dist.Visible = false

    ESPObjects[p].Health.Thickness = 3
    ESPObjects[p].Health.Visible = false

    local hl = ESPObjects[p].Highlight
    hl.FillColor = Color3.fromRGB(255, 255, 0)
    hl.OutlineColor = Color3.fromRGB(255, 255, 0)
    hl.FillTransparency = 0.5
    hl.OutlineTransparency = 0
    hl.Enabled = false
    hl.Parent = p.Character or p
end

local function RemoveESPForPlayer(p)
    local obj = ESPObjects[p]
    if not obj then return end
    if obj.Box then obj.Box:Remove() end
    if obj.Name then obj.Name:Remove() end
    if obj.Dist then obj.Dist:Remove() end
    if obj.Health then obj.Health:Remove() end
    if obj.Highlight then obj.Highlight:Destroy() end
    for _, line in ipairs(obj.SkeletonLines) do line:Remove() end
    ESPObjects[p] = nil
end

for _, p in ipairs(Players:GetPlayers()) do
    if p ~= player then CreateESPForPlayer(p) end
end
Players.PlayerAdded:Connect(function(p)
    if p ~= player then
        p.CharacterAdded:Connect(function() task.wait(1) CreateESPForPlayer(p) end)
    end
end)
Players.PlayerRemoving:Connect(RemoveESPForPlayer)

RunService.RenderStepped:Connect(function()
    for p, obj in pairs(ESPObjects) do
        local char = p.Character
        local hum = char and char:FindFirstChild("Humanoid")
        local head = char and char:FindFirstChild("Head")

        if not ESPEnabled or not char or not hum or hum.Health <= 0 or not head or not IsTeamMatchESP(p) then
            obj.Box.Visible = false
            obj.Name.Visible = false
            obj.Dist.Visible = false
            obj.Health.Visible = false
            obj.Highlight.Enabled = false
            for _, line in ipairs(obj.SkeletonLines) do line.Visible = false end
            continue
        end

        local myChar = player.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not myRoot then continue end

        local dist = (myRoot.Position - head.Position).Magnitude
        if dist > ESPMaxDist then
            obj.Box.Visible = false
            obj.Name.Visible = false
            obj.Dist.Visible = false
            obj.Health.Visible = false
            obj.Highlight.Enabled = false
            for _, line in ipairs(obj.SkeletonLines) do line.Visible = false end
            continue
        end

        local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
        if not onScreen then
            obj.Box.Visible = false
            obj.Name.Visible = false
            obj.Dist.Visible = false
            obj.Health.Visible = false
            obj.Highlight.Enabled = false
            for _, line in ipairs(obj.SkeletonLines) do line.Visible = false end
            continue
        end

        local boxHeight = math.clamp(4000 / dist, 30, 300)
        local boxWidth = boxHeight * 0.6

        if ESPBox then
            obj.Box.Size = Vector2.new(boxWidth, boxHeight)
            obj.Box.Position = Vector2.new(screenPos.X - boxWidth/2, screenPos.Y - boxHeight/2)
            obj.Box.Color = p.Team and p.Team.TeamColor.Color or Color3.new(1,1,1)
            obj.Box.Visible = true
        else
            obj.Box.Visible = false
        end

        if ESPName then
            obj.Name.Text = p.Name
            obj.Name.Position = Vector2.new(screenPos.X, screenPos.Y - boxHeight/2 - 18)
            obj.Name.Color = p.Team and p.Team.TeamColor.Color or Color3.new(1,1,1)
            obj.Name.Visible = true
        else
            obj.Name.Visible = false
        end

        if ESPDistance then
            obj.Dist.Text = string.format("%.0f studs", dist)
            obj.Dist.Position = Vector2.new(screenPos.X, screenPos.Y + boxHeight/2 + 4)
            obj.Dist.Visible = true
        else
            obj.Dist.Visible = false
        end

        if ESPHealth then
            local hp = hum.Health / hum.MaxHealth
            local barY = screenPos.Y - boxHeight/2 - 6
            obj.Health.From = Vector2.new(screenPos.X - boxWidth/2, barY)
            obj.Health.To = Vector2.new(screenPos.X - boxWidth/2 + boxWidth * hp, barY)
            obj.Health.Color = Color3.fromRGB(255 * (1 - hp), 255 * hp, 0)
            obj.Health.Visible = true
        else
            obj.Health.Visible = false
        end

        if ESPHighlight then
            obj.Highlight.Parent = char
            obj.Highlight.Enabled = true
        else
            obj.Highlight.Enabled = false
        end

        if ESPSkeleton then
            while #obj.SkeletonLines < #SKELETON_BONES do
                table.insert(obj.SkeletonLines, Drawing.new("Line"))
            end
            for i, bone in ipairs(SKELETON_BONES) do
                local a = char:FindFirstChild(bone[1])
                local b = char:FindFirstChild(bone[2])
                local line = obj.SkeletonLines[i]
                if a and b then
                    local aPos, aOn = Camera:WorldToViewportPoint(a.Position)
                    local bPos, bOn = Camera:WorldToViewportPoint(b.Position)
                    if aOn and bOn then
                        line.From = Vector2.new(aPos.X, aPos.Y)
                        line.To = Vector2.new(bPos.X, bPos.Y)
                        line.Color = p.Team and p.Team.TeamColor.Color or Color3.new(1,1,1)
                        line.Thickness = 1
                        line.Visible = true
                    else
                        line.Visible = false
                    end
                else
                    line.Visible = false
                end
            end
        else
            for _, line in ipairs(obj.SkeletonLines) do line.Visible = false end
        end
    end
end)
